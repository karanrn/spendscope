# Your config (start from `python -m spendscope init`; the example is spendscope/config.example.toml)
config.toml

# OAuth credentials and cached user tokens
oauth_client.json
service_account.json
authorized_user.json

# Local data, backups, generated dashboard
expenses.db*
backups/
dashboard.html
parse_failures.csv

# Python environment and build output
.venv/
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Bank statements (personal account data)
Acct_Statement_*

# Bank statements from any bank: keep them out of the repo (a statements/ folder is ignored)
statements/
*.xls
*.xlsx
*.xlsm
!spendscope/templates/expenses-template.xlsx
